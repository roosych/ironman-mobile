# ============================================
# Environment Configuration Files
# ============================================
# Реальные .env файлы с секретами НЕ ДОЛЖНЫ попадать в git!

.env.development
.env.staging
.env.production

# Но example файлы ДОЛЖНЫ быть в git
# .env.*.example

# ============================================
# Old Configuration Files (Migration Backup)
# ============================================

# Бэкап старых файлов конфигурации
lib/core/config/app_config_old.dart
lib/core/config/app_config_old_backup.dart
lib/core/config/app_config_new.dart

# ============================================
# Firebase Environment Configuration
# ============================================

# Active Firebase configs (НЕ коммитим активные конфиги)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Production configs (НЕ коммитим продакшн ключи в git!)
firebase-configs/prod/google-services.json
firebase-configs/prod/GoogleService-Info.plist

# Dev configs можно коммитить (безопасны для разработки)
# Они будут в firebase-configs/dev/

# Environment switcher logs
switch-env.logassets/adi-registration.properties
**/adi-registration.properties
