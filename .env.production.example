# Production Environment Configuration
# Скопируйте этот файл в .env.production и заполните реальными значениями

# ⚠️  ВНИМАНИЕ: Не добавляйте .env.production в git!
# ⚠️  Все значения ОБЯЗАТЕЛЬНЫ для production!

# ============================================
# SERVER SETTINGS
# ============================================

# Production API URL
API_BASE_URL=https://api.ironman.az/api/v1

# Таймауты подключения (в секундах)
CONNECT_TIMEOUT=30
RECEIVE_TIMEOUT=30

# ============================================
# API KEYS (ВСЕ ОБЯЗАТЕЛЬНЫ!)
# ============================================

# Google Maps API Key (production key с ограничениями по домену)
GOOGLE_MAPS_API_KEY=your_production_google_maps_key

# Firebase API Key (production project)
FIREBASE_API_KEY=your_production_firebase_key

# Другие API ключи (production)
OTHER_API_KEY=your_production_api_key

# ============================================
# DEBUG SETTINGS
# ============================================

# Отключить логирование в production (из соображений производительности)
ENABLE_LOGGING=false

# Режим отладки (автоматически false в production)
DEBUG_MODE=false