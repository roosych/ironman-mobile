# Добавьте эти строки в ваш .gitignore файл для защиты секретов

# ============================================
# Environment Configuration Files
# ============================================
# Реальные .env файлы с секретами НЕ ДОЛЖНЫ попадать в git!

.env.development
.env.staging
.env.production

# Но example файлы ДОЛЖНЫ быть в git
# .env.*.example

# ============================================
# Старые конфигурационные файлы (если используете)
# ============================================

# Если у вас есть старые файлы конфигурации
app_config.dart
config/secrets.dart
lib/core/config/app_config.dart

# ============================================
# Build Artifacts
# ============================================

# Сгенерированные файлы конфигурации
*.env.generated
build_config.dart