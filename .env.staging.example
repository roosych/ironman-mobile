# Staging Environment Configuration
# Скопируйте этот файл в .env.staging и заполните реальными значениями

# ============================================
# SERVER SETTINGS
# ============================================

# Staging API URL
API_BASE_URL=http://192.168.50.115:8081/api/v1

# Таймауты подключения (в секундах)
CONNECT_TIMEOUT=30
RECEIVE_TIMEOUT=30

# ============================================
# API KEYS
# ============================================

# Google Maps API Key (staging/test key)
GOOGLE_MAPS_API_KEY=your_staging_google_maps_key

# Firebase API Key (staging project)
FIREBASE_API_KEY=your_staging_firebase_key

# Другие API ключи (staging)
OTHER_API_KEY=your_staging_api_key

# ============================================
# DEBUG SETTINGS
# ============================================

# Включить логирование HTTP запросов
ENABLE_LOGGING=true

# Режим отладки
DEBUG_MODE=false