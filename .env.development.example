# Development Environment Configuration
# Скопируйте этот файл в .env.development и заполните реальными значениями

# ============================================
# SERVER SETTINGS
# ============================================

# Базовый URL API сервера
# Для Android эмулятора: http://10.0.2.2:8000/api/v1
# Для iOS симулятора: http://127.0.0.1:8000/api/v1
# Для физического устройства: http://192.168.1.XXX:8000/api/v1
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Таймауты подключения (в секундах)
CONNECT_TIMEOUT=30
RECEIVE_TIMEOUT=30

# ============================================
# API KEYS
# ============================================

# Google Maps API Key (получить на https://console.cloud.google.com/)
GOOGLE_MAPS_API_KEY=

# Firebase API Key (получить в Firebase Console)
FIREBASE_API_KEY=

# Другие API ключи
OTHER_API_KEY=

# ============================================
# DEBUG SETTINGS
# ============================================

# Включить логирование HTTP запросов (true/false)
ENABLE_LOGGING=true

# Режим отладки (автоматически true в development)
DEBUG_MODE=true